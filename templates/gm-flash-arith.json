{
	"self_serve_label": "Gemini 2.5 Flash",
	"model": "Flash",
	"request_model": "gemini-2.5-flash",
	"model_vendor": "google",
	"self_serve_default": true,
	"url": "{{BASE_URL}}/v1beta/models/{{MODEL}}:generateContent",
	"method": "POST",
	"headers": {
		"Content-Type": "application/json",
		"x-goog-api-key": "{{API_KEY}}",
		"User-Agent": "GeminiCLI/1.0"
	},
	"body": {
		"contents": [{
			"role": "user",
			"parts": [{
				"text": "{{PROMPT}}"
			}]
		}],
		"generationConfig": {
			"temperature": 0,
			"maxOutputTokens": 256,
			"thinkingConfig": { "thinkingBudget": 0 }
		}
	},
	"response": {
		"success_contains": "{{EXPECTED_ANSWER}}"
	},
	"probe": {
		"slow_latency": "5s",
		"timeout": "10s",
		"retry": 0
	}
}
