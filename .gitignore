prd.config.yaml

# Environment variables
.env
.env.local
.env.*
!/.env.example
!/.env.pg.example
# 允许提交前端生产环境配置模板（须在 .env.* 之后才能反选生效）
!frontend/.env.production
# Monitor data directory (root level only, avoid matching internal/monitor/)
/monitor/
!/monitor/.gitkeep

